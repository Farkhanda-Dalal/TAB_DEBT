{
  "manifest_version": 3,
  "name": "Tab Debt",
  "version": "1.0.0",
  "description": "AI-assisted automated tab cleanup for the MLH Lazy Challenge.",
  "permissions": ["tabs", "storage", "scripting", "activeTab", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open Tab Debt settings"
  }
}
